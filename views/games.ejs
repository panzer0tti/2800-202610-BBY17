<%- include("templates/header.ejs", {title: title, user: user} )%>

<%
  let xpClass = "xp-low";
  if (xpPercentage > 80) xpClass = "xp-high";
  else if (xpPercentage > 40) xpClass = "xp-mid";
%>

<div class="container py-5 game-page">

  <!-- LEVEL / XP CARD -->
  <div class="row justify-content-center">
    <div class="col-md-8">

      <div class="card game-card game-card-primary p-4">

        <h2 class="level-title mb-4">
          Level: <%= player.level %>
        </h2>

        <!-- XP BAR -->
        <div class="xp-container <%= xpClass %>">

          <div class="progress xp-progress">
            <div
              class="progress-bar progress-bar-striped progress-bar-animated bg-success"
              style="width: <%= xpPercentage %>%"
              role="progressbar"
              aria-valuenow="<%= xpPercentage %>"
              aria-valuemin="0"
              aria-valuemax="100"
            ></div>
          </div>

          <!-- XP TEXT -->
          <div class="xp-text">
            <div class="xp-text-inner">
              <span class="xp-current"><%= player.currentXP %></span>
              <span class="xp-divider">/</span>
              <span class="xp-max"><%= player.xpForNextLevel %></span>
              <span class="xp-label">EXP</span>
            </div>
          </div>

        </div>

        <!-- REMAINING XP -->
        <p class="xp-remaining mt-3">
          <%= remainingXP %> EXP until next level
        </p>

      </div>
    </div>
  </div>

  <!-- GAME ACTIONS -->
  <div class="row justify-content-center mt-4">
    <div class="col-md-8">

      <div class="card game-card game-card-secondary p-4">

        <!-- GAME BUTTONS -->
        <div class="d-flex flex-column gap-3 align-items-center">

          <button class="game-btn-primary">
            New Ranked Match Session
          </button>

          <a href="/plant-game/guess-plants" class="game-btn-secondary">
            Plant Knowledge Review
          </a>

        </div>

        <!-- MATCH HISTORY TITLE -->
        <h2 class="history-title mt-4">
          Match History
        </h2>

        <!-- MATCH LIST -->
        <% if (matches && matches.length > 0) { %>

          <div class="mt-3 d-flex flex-column gap-3">

            <% matches.forEach(match => { %>
              <div class="card game-card game-card-elevated p-3">
                <div class="card-body">
                  <h3 class="match-title">
                    <%= match.name %>
                  </h3>
                </div>
              </div>
            <% }) %>

          </div>

        <% } else { %>
          <p class="text-muted mt-3">
            No match found.
          </p>
        <% } %>

      </div>

    </div>
  </div>

</div>

<%- include("templates/footer.ejs") %>
