<nav class="navbar navbar-expand-lg custom-header-bar fw-bold">

  <div class="container-fluid gap-2">

    <!-- BRAND -->
    <a class="navbar-brand title tw-font-extrabold tw-tracking-wide fs-5"
       href="/">
      BeWilder
    </a>

    <!-- TOGGLER -->
    <button class="navbar-toggler custom-toggler border-0"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNav"
            aria-expanded="false">

      <span></span>
      <span></span>
      <span></span>
    </button>

    <!-- NAV -->
    <div class="collapse navbar-collapse gap-3" id="navbarNav">

      <ul class="navbar-nav me-auto mb-5 mb-lg-0 gap-3">

        <% const links = user ? locals.navLinksAuth : locals.navLinksUnauth %>

        <% for (let link of links) { %>
          <li class="nav-item">

            <% if (link.name === "Logout") { %>
              <a class="nav-link app-links btn btn-logout w-100 w-lg-auto"
                 href="<%= link.url %>">
                <%= link.name %>
              </a>
            <% } else { %>
              <a class="nav-link app-links w-100 w-lg-auto <%= link.url === locals.folder ? 'active' : '' %>"
                 href="<%= link.url %>">
                <%= link.name %>
              </a>
            <% } %>

          </li>
        <% } %>

      </ul>

      <!-- SEARCH -->
      <form class="search-bar d-flex flex-lg-row justify-content-center 
                   gap-4 w-100 w-lg-auto"
            action="/search"
            method="post">

        <input class="form-control search-input tw-rounded-lg"
               type="search"
               name="query"
               placeholder="Search plants..." />

        <button class="btn btn-outline-forest search-btn w-25 w-lg-auto"
                type="submit">
          Search
        </button>

      </form>

    </div>
  </div>
</nav>